# --- Meta / Instagram Graph API (Checkpoint A) ---
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:8765/callback
GRAPH_API_VERSION=v23.0

# --- Postgres (Checkpoint B — Neon) ---
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# --- Token encryption (self-generated locally, no external account) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Voyage AI embeddings (Checkpoint C) ---
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3-lite

# --- Qdrant Cloud (Checkpoint C) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=reels

# --- Creator DNA job defaults ---
CREATOR_DNA_EARLY_PROFILE_THRESHOLD=15
CREATOR_DNA_RECENT_FATIGUE_WINDOW=10
CREATOR_DNA_DEFAULT_PRIMARY_KPI=reach
PERSONAL_NOVELTY_WINDOW=10

LOG_LEVEL=INFO

# --- Anthropic API (Build Doc 2 — Checkpoint D) ---
ANTHROPIC_API_KEY=
MODEL_HAIKU=claude-haiku-4-5
MODEL_SONNET=claude-sonnet-5

# --- Market Researcher external sources (optional — Checkpoint D) ---
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=CreatorOS/0.1 (research agent)

MARKET_RESEARCHER_MAX_ITERATIONS=5
EXTERNAL_CACHE_TTL_HOURS=12

OPPORTUNITY_CANDIDATE_MIN=20
OPPORTUNITY_CANDIDATE_MAX=50

EPSILON_EXPLORE_RATE=0.15
EXPLORE_QUALITY_FLOOR_PERCENTILE=0.40

WEIGHT_CREATOR_FIT=0.2
WEIGHT_AUDIENCE_DEMAND=0.2
WEIGHT_TREND_MOMENTUM=0.2
WEIGHT_NOVELTY=0.2
WEIGHT_EXPECTED_ENGAGEMENT=0.2
