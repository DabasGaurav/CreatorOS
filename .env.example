# --- Meta / Instagram Graph API (Checkpoint A) ---
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:8765/callback
GRAPH_API_VERSION=v21.0

# --- Postgres (Checkpoint B — Neon) ---
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# --- Token encryption (self-generated locally, no external account) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Voyage AI embeddings (Checkpoint C) ---
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3-lite

# --- Qdrant Cloud (Checkpoint C) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=reels

# --- Creator DNA job defaults ---
CREATOR_DNA_EARLY_PROFILE_THRESHOLD=15
CREATOR_DNA_RECENT_FATIGUE_WINDOW=10
CREATOR_DNA_DEFAULT_PRIMARY_KPI=reach
PERSONAL_NOVELTY_WINDOW=10

LOG_LEVEL=INFO
